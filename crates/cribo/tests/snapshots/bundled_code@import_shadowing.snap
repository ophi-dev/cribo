    return "TOP_LEVEL_UTILS"
utils.transform = transform
package_a_processor = _cribo.types.SimpleNamespace(__name__='package_a.processor', __doc__='Package A processor that imports utils expecting package_a.utils')
package_a.processor = package_a_processor
