"""Every dependency of an external distribution stays external.\n\n`blocked-dep` reads __file__ (a source blocker) and stays installed; its\nRequires-Dist chain (mid-pure -> leaf-pure) is installed transitively, so\nbundling leaf_pure would split module identity between the inlined copy\nand the installed copy blocked_dep's code imports.\n"""
import sys as _sys
import importlib as _importlib
class _CriboModule():

    def __init__(_cribo_self, m, p):
        _cribo_self._m, _cribo_self._p = m, p

    def __getattr__(_cribo_self, n):
        f = _cribo_self._p + '.' + n
        try:
            return _CriboModule(_importlib.import_module(f), f)
        except ImportError:
            return getattr(_cribo_self._m, n)

    def __getattribute__(_cribo_self, n):
        return object.__getattribute__(_cribo_self, n) if n in ('_m', '_p', '__getattr__', '__class__', '__dict__', '__dir__', '__module__', '__qualname__') else getattr(object.__getattribute__(_cribo_self, '_m'), n)
class _Cribo():

    def __getattr__(_cribo_self, n):
        m = _sys.modules.get(n) or _importlib.import_module(n)
        return _CriboModule(m, n)
_cribo = _Cribo()
import blocked_dep
import leaf_pure
print("shared:", blocked_dep.uses() is leaf_pure.MARKER)
