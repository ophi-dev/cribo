    assert MyObjectA.yaml_tag == "!myobject_a"

    class MyObjectB(YAMLObjectB):
        yaml_tag = "!myobject_b"

        def __init__(self, value):
            self.value = value * 2
    obj_b = MyObjectB(21)
    assert obj_b.value == 42
    assert MyObjectB.yaml_tag == "!myobject_b"
    print("Both metaclass tests passed")
